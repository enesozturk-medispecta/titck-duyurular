&lt;/span&gt;&lt;/p&gt;&lt;p align=&quot;center&quot; class=&quot;MsoNormal&quot; style=&quot;text-align:center&quot;&gt;&lt;b&gt;&lt;span new=&quot;&quot; roman&quot;,serif&quot;=&quot;&quot; style=&quot;font-size:12.0pt;line-height:107%;font-family:&quot; times=&quot;&quot;&gt;MÜFETTİŞ
YARDIMCILIĞI YAZILI SINAVINI KAZANIP SÖZLÜ SINAVA GİRMEYE HAK KAZANAN ADAYLAR&lt;o:p&gt;&lt;/o:p&gt;&lt;/span&gt;&lt;/b&gt;&lt;/p&gt;&lt;p class=&quot;MsoNormal&quot; style=&quot;margin-top:6.0pt;margin-right:0cm;margin-bottom:0cm;
